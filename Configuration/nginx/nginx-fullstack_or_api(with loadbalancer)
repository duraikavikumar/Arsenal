upstream mfdev_backend {
    server 127.0.0.1:8080;
    server 127.0.0.1:8081;
    # Optional: configure balancing method (default is round-robin)
    # least_conn;
    # ip_hash;
}

server {
    listen 80 default_server;
    server_name mfdev-go.aliceblueonline.com www.mfdev-go.aliceblueonline.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name mfdev-go.aliceblueonline.com www.mfdev-go.aliceblueonline.com;

    ssl_certificate /etc/ssl/certs/ssl-bundle.crt;
    ssl_certificate_key /etc/ssl/certs/domain.tld.key;

    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    access_log /var/log/nginx/mfdev-go-access.log;
    error_log  /var/log/nginx/mfdev-go-error.log;

    location / {
        proxy_pass http://mfdev_backend;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_cache_bypass $http_upgrade;
    }
}
